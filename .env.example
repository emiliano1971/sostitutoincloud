# Database — copia in .env e adatta alle tue credenziali locali
DB_URL=jdbc:postgresql://localhost:5432/sostitutoincloud
DB_USERNAME=sostitutoincloud
DB_PASSWORD=postgres

# Segreto di firma dei token JWT — minimo 32 byte (HS256), generalo con:
#   openssl rand -base64 48
# In locale lascialo commentato: application-local.yml ha un default di sviluppo.
# Valorizzarlo a vuoto NON equivale a ometterlo — la stringa vuota vince sul default
# e fa fallire la firma HS256, quindi o gli dai un valore vero o lo lasci commentato.
# In test e prod è OBBLIGATORIO e NON va messo qui: sotto Tomcat il .env della root
# non viene letto (con catalina la working directory è bin/), quindi impostalo come
# variabile d'ambiente nel setenv.sh o nelle env variables di Coolify.
#APP_JWT_SECRET=

# Frontend (Vite dev server)
# In produzione/test (WAR su Tomcat) il frontend usa il config.json runtime;
# VITE_API_BASE_URL serve solo al dev server Vite.
VITE_API_BASE_URL=http://localhost:8081/sostitutoincloud/api
